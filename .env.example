# Provider selection. Every provider has a `mock` implementation reading data/fixtures/.
PROVIDER_PRICES=yfinance        # yfinance | mock
PROVIDER_CALENDAR=forexfactory  # forexfactory | mock
PROVIDER_NEWS=rss               # rss | mock
PROVIDER_SERIES=fred            # fred | mock   (real yields / breakevens; needs FRED_API_KEY else "unavailable")
PROVIDER_LLM=rules              # rules | anthropic | openai | mock

# Optional keys. Nothing here is required.
FRED_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible endpoint (Ollama works)
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1

# Behaviour
CANDLE_ANCHOR=forex             # forex (17:00 ET daily open) | exchange (18:00 ET)
SCHEDULE=0                      # 1 = APScheduler runs the scan at 07:00 ET on trading days and post-session at 12:15
DATA_DIR=../data                # relative to backend/
CACHE_TTL_MIN=10
